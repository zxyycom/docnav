{
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "endLine",
          "entries",
          "id",
          "line",
          "sourcePath",
          "summary",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "catalogPath": {
      "type": "string",
      "minLength": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "catalog",
              "index"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "indexPath": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "schemaVersion": {
      "const": 4
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "description",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "cases",
    "catalogPath",
    "diagnostics",
    "indexPath",
    "limit",
    "offset",
    "schemaVersion",
    "topics",
    "total"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-query-result.schema.json",
  "title": "TestEvidenceQueryResult"
}
