{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "description",
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "topics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-topic-catalog.schema.json",
  "title": "TestEvidenceTopicCatalog"
}
