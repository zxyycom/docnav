{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docnav.dev/test-evidence/claim-topic-catalog.schema.json",
  "title": "ClaimTopicCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "topics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 4,
            "maxLength": 200
          }
        }
      }
    }
  }
}
