{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docnav.dev/test-evidence/test-evidence-index.schema.json",
  "title": "TestEvidenceIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceRevision",
    "inventoryRevision",
    "topics",
    "entries",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inventoryRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "topics": {
      "type": "array"
    },
    "entries": {
      "type": "array"
    },
    "claims": {
      "type": "array"
    }
  }
}
