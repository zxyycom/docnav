        "id": "adapter-selection"
      },
      {
        "description": "维护长期决策的记录、生命周期、演进关系及其与 owner 规范和 Change Plan 的分工。",
        "id": "decision-management"
      },
      {
        "description": "维护实现代码规范、项目 agent 指令、Skill 准入与工程能力路由的长期方向。",
        "id": "engineering-guidance"
      },
      {
        "description": "维护 JSON 导航的 ref、树遍历、原文查找、解析保真、输入约束、安全上限与结构化序列化方向。",
        "id": "json-navigation"
      },
      {
        "description": "维护产品阶段、能力与格式扩展排序、探索与交付边界以及入口扩张时机的长期方向。",
        "id": "product-direction"
      },
      {
        "description": "维护 readable-view 的格式专用展示、renderer 责任与 raw protocol 隔离的长期方向。",
        "id": "readable-presentation"
      },
      {
        "description": "维护跨格式 structured selection、完整 source text、source fidelity 与 format-owned ordering 的长期方向。",
        "id": "structured-read-semantics"
      },
      {
        "description": "维护本机不可用执行环境的验收、受控云端验证与外部写入边界的长期方向。",
        "id": "validation-governance"
      }
    ]
  },
