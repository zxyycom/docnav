{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docnav.dev/test-evidence/supported-runner-profile.schema.json",
  "title": "SupportedRunnerProfile",
  "$defs": {
    "safeRelativePosixPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$)[^\\u0000]+$"
    },
    "safeRelativePosixGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![!#])(?!\\s)(?!.*\\s$)(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$)[^\\u0000]+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "cargo",
    "bun",
    "smoke"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRoots",
        "targetKinds",
        "doctests"
      ],
      "properties": {
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixPath"
          }
        },
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bin",
              "lib",
              "test"
            ]
          }
        },
        "doctests": {
          "const": "block-until-supported"
        }
      }
    },
    "bun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRoots",
        "include",
        "ignore",
        "supplementalFiles"
      ],
      "properties": {
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixPath"
          }
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixGlob"
          }
        },
        "ignore": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixGlob"
          }
        },
        "supplementalFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixPath"
          }
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "factory",
        "sourceRoots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "factory": {
          "const": "test/smoke/core/profile.ts"
        },
        "sourceRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePosixPath"
          }
        }
      }
    }
  }
}
