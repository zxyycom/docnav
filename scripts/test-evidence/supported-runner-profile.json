{
  "schemaVersion": 2,
  "id": "docnav-native-tests",
  "version": 2,
  "cargo": {
    "sourceRoots": [
      "crates"
    ],
    "targetKinds": [
      "bin",
      "lib",
      "test"
    ],
    "doctests": "block-until-supported"
  },
  "bun": {
    "sourceRoots": [
      "scripts",
      "test"
    ],
    "include": [
      "**/*.test.ts"
    ],
    "ignore": [],
    "supplementalFiles": []
  },
  "smoke": {
    "id": "core",
    "factory": "test/smoke/core/profile.ts",
    "sourceRoots": [
      "test/smoke/core/cases"
    ]
  }
}
